# ============================================================
# .env.example — Ortam Değişkeni Şablonu
# ============================================================
# Bu dosya, projenin ihtiyaç duyduğu tüm ortam değişkenlerini
# gösterir. Gerçek değerleri içeren ".env" dosyasını oluşturmak
# için bu dosyayı kopyalayın:
#
#   cp .env.example .env
#
# UYARI: Gerçek .env dosyasını asla Git'e commit etmeyin!
# Sadece bu .env.example dosyası repoda bulunmalıdır.
# ============================================================

# --- JWT (JSON Web Token) Gizli Anahtarı ---
# Token imzalamak için kullanılır. Güvenli, rastgele bir string olmalı.
# Üretmek için: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=buraya-cok-gizli-rastgele-bir-string-koyun-asla-bos-birakmayın

# --- JWT Token Geçerlilik Süresi (dakika cinsinden) ---
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- JWT Algoritması ---
# HS256 (HMAC SHA-256) — simetrik imzalama, tek anahtar yeterli
ALGORITHM=HS256

# --- Veritabanı Bağlantı URL'si ---
# Geliştirme için SQLite (dosya tabanlı, kurulum gerektirmez)
# Üretim için: postgresql://kullanici:sifre@host:5432/veritabani
DATABASE_URL=sqlite:///./ocr_app.db

# --- Uygulama Ortamı ---
# "development" veya "production"
APP_ENV=development

# --- Yüklenecek Dosyaların Kaydedileceği Klasör ---
UPLOAD_DIR=uploads

# ============================================================
# Aşama 2 — OCR & AI Entegrasyonu
# ============================================================

# --- Google Gemini API Anahtarı ---
# LangChain + Gemini ile fatura verisi çıkarmak için gerekli.
# Ücretsiz API anahtarı için: https://aistudio.google.com/
# Ücretsiz kota: Dakikada 15 istek, günde 1500 istek (Gemini Flash)
GOOGLE_API_KEY=buraya-google-ai-studio-api-anahtarinizi-girin

# --- Tesseract OCR Binary Yolu (Windows) ---
# Windows'ta pytesseract Tesseract binary'sini otomatik bulamayabilir.
# Kurulum: winget install UB-Mannheim.TesseractOCR
# Kurulum sonrası varsayılan yol:
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/Mac'te bu satırı yorum satırına alın veya silin.
# Tesseract PATH'e ekliyse buraya gerek yok.

# --- OCR Dil Paketi ---
# Faturalarınızın dili. Tesseract dil kodları:
#   tur = Türkçe, eng = İngilizce, tur+eng = Her ikisi
# Türkçe paket kurulumu (Windows): Tesseract installer'dan "tur" seçin
OCR_LANGUAGE=tur+eng

# --- Gemini Model Adı ---
# Kullanılacak Gemini model versiyonu.
# Güncel model listesi: https://ai.google.dev/gemini-api/docs/models/gemini
GEMINI_MODEL=gemini-3.8-flash

# --- AI Zaman Aşımı (saniye) ---
# Gemini API yanıt beklenecek maksimum süre.
# Bu süreden uzun süren istekler iptal edilir, fatura "failed" olarak işaretlenir.
AI_TIMEOUT_SECONDS=60
